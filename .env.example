# ── Connexion PostgreSQL ──────────────────────────────────
# Local  : postgresql://USER:MOTDEPASSE@localhost:5432/justepargne
# Render : copie l'"Internal Database URL" (ou "External") du dashboard de la DB
DATABASE_URL=

# Port d'écoute (Render le fournit automatiquement, ne pas y toucher en prod)
PORT=3000

# SSL : mets "disable" SEULEMENT en local si ton Postgres n'a pas de SSL.
# En prod (Render), laisse vide ou mets "require".
PGSSL=disable

# Secret pour signer les JWT (mets une longue chaîne aléatoire, gardée secrète)
JWT_SECRET=
